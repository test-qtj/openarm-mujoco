    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="energy_rack_material" rgba="0.38 0.42 0.46 1" reflectance="0.12"/>
    <material name="energy_cell_material" rgba="0.95 0.24 0.035 1" reflectance="0.15"/>
    <mesh name="energy_rack_visual_mesh" file="energy_rack/rack_visual.stl" scale="0.001 0.001 0.001"/>
    <mesh name="energy_cell_mesh_1" file="energy_rack/energy_cell_1.stl" scale="0.001 0.001 0.001"/>
